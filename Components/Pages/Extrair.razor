@page "/extrair"
@rendermode InteractiveServer
@inject ProcessadorPlanilha Processador

<div class="page-head">
    <div>
        <h1>Extrair da planilha</h1>
        <p class="subtitle">
            Lê o pedido da coluna <b>K</b> (ex.: AF3242-01), abre o PDF da proposta na pasta do pedido e preenche
            as colunas <b>L</b> modelo · <b>M</b> serial · <b>N</b> part number · <b>O</b> preço unitário ·
            <b>P</b> preço total · <b>Q</b> prazo. Os PDFs e a planilha original não são alterados — a cópia preenchida é salva na mesma pasta da planilha, com o final <b>_preenchido.xlsx</b>.
        </p>
    </div>
</div>

<div class="panel">
    <div class="form-grid">
        <label>Pasta dos pedidos (pode usar xxxx no lugar do número da AF)
            <input class="cell" @bind="_pastaBase" disabled="@_rodando" />
        </label>
        <label>Primeira linha de dados
            <input class="cell num" type="number" min="1" @bind="_linhaInicial" disabled="@_rodando" style="width:110px" />
        </label>
        <label>Caminho da planilha Excel (.xlsx) — no Explorer: Shift + botão direito no arquivo → "Copiar como caminho"
            <input class="cell" @bind="_caminho" placeholder="C:\\Users\\...\\planilha.xlsx" disabled="@_rodando" />
        </label>
    </div>

    <div class="toolbar" style="margin-top:16px">
        <button class="btn-primary" @onclick="Iniciar" disabled="@(_rodando || string.IsNullOrWhiteSpace(_caminho))">
            @(_rodando ? "Processando…" : "Processar")
        </button>
        <span class="saved-flag">@_mensagem</span>
    </div>

    @if (_erro is not null)
    {
        <div class="alert-error">@_erro</div>
    }
</div>

@if (_total > 0)
{
    <div class="summary-bar" style="margin-top:16px">
        @_resultados.Count de @_total pedidos processados ·
        @_resultados.Count(r => r.Status == StatusLinha.Ok) OK ·
        @_resultados.Count(r => r.Status == StatusLinha.Aviso) com aviso ·
        @_resultados.Count(r => r.Status == StatusLinha.Erro) com erro
    </div>

    <table class="grid">
        <thead><tr><th>Linha</th><th>Pedido</th><th>Status</th><th>Detalhe</th></tr></thead>
        <tbody>
            @foreach (var r in _resultados)
            {
                <tr>
                    <td>@r.Linha</td>
                    <td class="nowrap">@r.Pedido</td>
                    <td><span class="badge @Classe(r.Status)">@r.Status.ToString().ToUpperInvariant()</span></td>
                    <td>@r.Detalhe</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string _pastaBase = "";
    private string _caminho = "";
    private int _linhaInicial;
    private bool _rodando;
    private string? _erro, _mensagem;
    private int _total;
    private readonly List<ResultadoLinha> _resultados = new();

    protected override void OnInitialized()
    {
        _pastaBase = Processador.Opcoes.PastaBase;
        _linhaInicial = Processador.Opcoes.LinhaInicial;
    }

    private static string Classe(StatusLinha s) => s switch
    {
        StatusLinha.Ok => "st-ok",
        StatusLinha.Aviso => "st-urgente",
        _ => "st-vencida",
    };

    private async Task Iniciar()
    {
        _rodando = true; _erro = null; _resultados.Clear(); _total = 0;
        _mensagem = "Lendo a planilha…";
        try
        {
            // "Copiar como caminho" do Windows põe aspas em volta.
            var origem = _caminho.Trim().Trim('"');
            if (!File.Exists(origem))
                throw new FileNotFoundException("Arquivo não encontrado: " + origem);

            // Leitura só-leitura e compartilhada: funciona mesmo com a planilha aberta no Excel.
            var ms = new MemoryStream();
            await using (var fs = new FileStream(origem, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                await fs.CopyToAsync(ms);
            ms.Position = 0;

            var pasta = _pastaBase.Trim().Trim('"');
            var linha = _linhaInicial;
            var ui = new List<ResultadoLinha>();

            var saida = await Task.Run(() => Processador.Processar(ms, pasta, linha, (total, r) =>
            {
                lock (ui) ui.Add(r);
                _ = InvokeAsync(() =>
                {
                    _total = total;
                    lock (ui) { _resultados.Clear(); _resultados.AddRange(ui); }
                    _mensagem = $"Processando… {ui.Count}/{total}";
                    StateHasChanged();
                });
            }));

            var destino = Path.Combine(Path.GetDirectoryName(origem)!,
                Path.GetFileNameWithoutExtension(origem) + "_preenchido.xlsx");
            await File.WriteAllBytesAsync(destino, saida);
            _mensagem = "Concluído — salvo em " + destino;
        }
        catch (Exception ex)
        {
            _erro = "Não foi possível processar a planilha: " + ex.Message;
            _mensagem = null;
        }
        finally
        {
            _rodando = false;
        }
    }
}
